{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "true"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Task",
      "NotebookEdit",
      "mcp__ide__getDiagnostics",
      "mcp__ide__executeCode"
    ],
    "additionalDirectories": [
      "/Users/satori/Documents/Development/Veliano/src/app/[locale]/admin",
      "/Users/satori/Documents/Development/KaufDahoam/KaufDahoam/apps/web/app/[locale]",
      "/Users/satori/Documents/Development/KaufDahoam/KaufDahoam/apps/web/app/[locale]/hof/[slug]",
      "/Users/satori/Documents/Development/Kriyaverse-Antigravity",
      "/Users/satori/Documents/Development/Kriyaverse"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/satori/.claude/hooks/gsd-check-update.js\""
          },
          {
            "type": "command",
            "command": "node \"/Users/satori/.claude/hooks/vault-index-builder.js\""
          },
          {
            "type": "command",
            "command": "node \"/Users/satori/.claude/hooks/vault-context-loader.js\""
          },
          {
            "type": "command",
            "command": "node \"/Users/satori/.claude/hooks/handoff-resume-loader.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/satori/.claude/hooks/spec-gate.js\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/satori/.claude/hooks/gsd-context-monitor.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/satori/.claude/hooks/vault-reflection-writer.js\""
          },
          {
            "type": "command",
            "command": "node \"/Users/satori/.claude/hooks/productization-tracker.js\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"/Users/satori/.claude/hooks/gsd-statusline.js\""
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true
}
